digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
"任务失败回退" [fillcolor=cyan, fontcolor=black, fontsize=9, label="任务失败回退", shape=octagon, style=filled];
"主流程_带安全监视" [fillcolor=orange, fontcolor=black, fontsize=9, label="主流程_带安全监视", shape=box, style=filled];
"任务失败回退" -> "主流程_带安全监视";
IsSafetyOk [fillcolor=gray, fontcolor=black, fontsize=9, label=IsSafetyOk, shape=ellipse, style=filled];
"主流程_带安全监视" -> IsSafetyOk;
"任务阶段序列" [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ 任务阶段序列", shape=box, style=filled];
"主流程_带安全监视" -> "任务阶段序列";
"SafetyInit 安全初始化" [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ SafetyInit 安全初始化", shape=box, style=filled];
"任务阶段序列" -> "SafetyInit 安全初始化";
WaitResetCommand [fillcolor=gray, fontcolor=black, fontsize=9, label=WaitResetCommand, shape=ellipse, style=filled];
"SafetyInit 安全初始化" -> WaitResetCommand;
ResetToStance [fillcolor=gray, fontcolor=black, fontsize=9, label=ResetToStance, shape=ellipse, style=filled];
"SafetyInit 安全初始化" -> ResetToStance;
WaitMotionEnabled [fillcolor=gray, fontcolor=black, fontsize=9, label=WaitMotionEnabled, shape=ellipse, style=filled];
"SafetyInit 安全初始化" -> WaitMotionEnabled;
"DeployAndLand 下放落地" [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ DeployAndLand 下放落地", shape=box, style=filled];
"任务阶段序列" -> "DeployAndLand 下放落地";
"落地超时" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="落地超时", shape=ellipse, style=filled];
"DeployAndLand 下放落地" -> "落地超时";
IsLandingConfirmed [fillcolor=gray, fontcolor=black, fontsize=9, label=IsLandingConfirmed, shape=ellipse, style=filled];
"落地超时" -> IsLandingConfirmed;
ReportStatus [fillcolor=gray, fontcolor=black, fontsize=9, label=ReportStatus, shape=ellipse, style=filled];
"DeployAndLand 下放落地" -> ReportStatus;
ReleaseXiaolan [fillcolor=gray, fontcolor=black, fontsize=9, label=ReleaseXiaolan, shape=ellipse, style=filled];
"DeployAndLand 下放落地" -> ReleaseXiaolan;
"LocalizeAndApproach 定位与接近" [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ LocalizeAndApproach 定位与接近", shape=box, style=filled];
"任务阶段序列" -> "LocalizeAndApproach 定位与接近";
LocalizeXiaolan [fillcolor=gray, fontcolor=black, fontsize=9, label=LocalizeXiaolan, shape=ellipse, style=filled];
"LocalizeAndApproach 定位与接近" -> LocalizeXiaolan;
"粗导航重试" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="粗导航重试", shape=ellipse, style=filled];
"LocalizeAndApproach 定位与接近" -> "粗导航重试";
"接近超时" [fillcolor=ghostwhite, fontcolor=black, fontsize=9, label="接近超时", shape=ellipse, style=filled];
"粗导航重试" -> "接近超时";
CoarseNavigateToTag [fillcolor=gray, fontcolor=black, fontsize=9, label=CoarseNavigateToTag, shape=ellipse, style=filled];
"接近超时" -> CoarseNavigateToTag;
PrepareClimbPosture [fillcolor=gray, fontcolor=black, fontsize=9, label=PrepareClimbPosture, shape=ellipse, style=filled];
"LocalizeAndApproach 定位与接近" -> PrepareClimbPosture;
"ClimbOntoXiaolan 攀爬" [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ ClimbOntoXiaolan 攀爬", shape=box, style=filled];
"任务阶段序列" -> "ClimbOntoXiaolan 攀爬";
RunClimbStages [fillcolor=gray, fontcolor=black, fontsize=9, label=RunClimbStages, shape=ellipse, style=filled];
"ClimbOntoXiaolan 攀爬" -> RunClimbStages;
"VisualDockAndClamp 视觉对接与夹紧" [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ VisualDockAndClamp 视觉对接与夹紧", shape=box, style=filled];
"任务阶段序列" -> "VisualDockAndClamp 视觉对接与夹紧";
EnterTerminalPosture [fillcolor=gray, fontcolor=black, fontsize=9, label=EnterTerminalPosture, shape=ellipse, style=filled];
"VisualDockAndClamp 视觉对接与夹紧" -> EnterTerminalPosture;
VisualAlignDock [fillcolor=gray, fontcolor=black, fontsize=9, label=VisualAlignDock, shape=ellipse, style=filled];
"VisualDockAndClamp 视觉对接与夹紧" -> VisualAlignDock;
LiftLegs [fillcolor=gray, fontcolor=black, fontsize=9, label=LiftLegs, shape=ellipse, style=filled];
"VisualDockAndClamp 视觉对接与夹紧" -> LiftLegs;
ClampDockPost [fillcolor=gray, fontcolor=black, fontsize=9, label=ClampDockPost, shape=ellipse, style=filled];
"VisualDockAndClamp 视觉对接与夹紧" -> ClampDockPost;
"ReportStatus*" [fillcolor=gray, fontcolor=black, fontsize=9, label="ReportStatus*", shape=ellipse, style=filled];
"VisualDockAndClamp 视觉对接与夹紧" -> "ReportStatus*";
"RecoveryReport 回收与完成" [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ RecoveryReport 回收与完成", shape=box, style=filled];
"任务阶段序列" -> "RecoveryReport 回收与完成";
WaitWinchHoisted [fillcolor=gray, fontcolor=black, fontsize=9, label=WaitWinchHoisted, shape=ellipse, style=filled];
"RecoveryReport 回收与完成" -> WaitWinchHoisted;
"ReportStatus**" [fillcolor=gray, fontcolor=black, fontsize=9, label="ReportStatus**", shape=ellipse, style=filled];
"RecoveryReport 回收与完成" -> "ReportStatus**";
"失败处理" [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ 失败处理", shape=box, style=filled];
"任务失败回退" -> "失败处理";
SafeResetToStand [fillcolor=gray, fontcolor=black, fontsize=9, label=SafeResetToStand, shape=ellipse, style=filled];
"失败处理" -> SafeResetToStand;
"ReportStatus***" [fillcolor=gray, fontcolor=black, fontsize=9, label="ReportStatus***", shape=ellipse, style=filled];
"失败处理" -> "ReportStatus***";
}
