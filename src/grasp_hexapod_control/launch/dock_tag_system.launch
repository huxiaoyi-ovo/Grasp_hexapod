<launch>
  <!-- Bottom USB camera only: never reuse the top Orbbec/xiaolan tag chain. -->
  <arg name="video_device" default="/dev/video0"/>
  <arg name="image_width" default="1280"/>
  <arg name="image_height" default="720"/>
  <!-- The real camera exposes 1280x720 YUYV at 10 Hz.  Request that mode
       explicitly so the driver does not negotiate a slower fallback. -->
  <arg name="framerate" default="10"/>
  <arg name="pixel_format" default="yuyv"/>
  <arg name="color_format" default="yuv422p"/>
  <arg name="camera_name" default="dock_camera"/>
  <arg name="camera_info_url" default="file://$(find grasp_hexapod_control)/config/dock_camera.yaml"/>
  <arg name="camera_frame_id" default="dock_camera_optical_frame"/>
  <arg name="lock_frame" default="dock_lock_center"/>
  <arg name="pin_frame_prefix" default="dock_pin_from_tag_"/>
  <arg name="dock_system_config" default="$(find grasp_hexapod_control)/config/dock_system.yaml"/>
  <arg name="detections_topic" default="/dock/tag_detections"/>

  <include file="$(find grasp_hexapod_control)/launch/dock_tf_chain.launch">
    <arg name="lock_frame" value="$(arg lock_frame)"/>
    <arg name="camera_frame" value="$(arg camera_frame_id)"/>
    <arg name="pin_frame_prefix" value="$(arg pin_frame_prefix)"/>
  </include>

  <node pkg="usb_cam" type="usb_cam_node" name="usb_cam" ns="dock_camera" output="screen">
    <param name="video_device" value="$(arg video_device)"/>
    <param name="image_width" value="$(arg image_width)"/>
    <param name="image_height" value="$(arg image_height)"/>
    <param name="framerate" value="$(arg framerate)"/>
    <param name="pixel_format" value="$(arg pixel_format)"/>
    <param name="color_format" value="$(arg color_format)"/>
    <param name="camera_name" value="$(arg camera_name)"/>
    <param name="camera_info_url" value="$(arg camera_info_url)"/>
    <param name="camera_frame_id" value="$(arg camera_frame_id)"/>
    <param name="io_method" value="mmap"/>
    <!-- This usb_cam publishes under its node name (dock_camera/usb_cam/...);
         remap to the plain topics image_proc and apriltag_ros expect. -->
    <remap from="/dock_camera/usb_cam/image_raw" to="/dock_camera/image_raw"/>
    <remap from="/dock_camera/usb_cam/camera_info" to="/dock_camera/camera_info"/>
  </node>

  <group ns="dock_camera">
    <node pkg="nodelet" type="nodelet" name="image_proc_manager" args="manager" output="screen"/>
    <include file="$(find image_proc)/launch/image_proc.launch">
      <arg name="manager" value="/dock_camera/image_proc_manager"/>
    </include>
  </group>

  <node pkg="apriltag_ros" type="apriltag_ros_continuous_node" name="apriltag" ns="dock" output="screen">
    <remap from="image_rect" to="/dock_camera/image_rect_color"/>
    <remap from="camera_info" to="/dock_camera/camera_info"/>
    <remap from="tag_detections" to="$(arg detections_topic)"/>
    <rosparam command="load" file="$(arg dock_system_config)"/>
  </node>
</launch>
