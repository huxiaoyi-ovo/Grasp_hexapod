<launch>
  <!-- 这些参数必须定义，因为 run_real.launch 会传递它们 -->
  <arg name="video_device" default="/dev/video0"/>
  <arg name="pixel_format" default="yuyv"/>
  <arg name="color_format" default="yuv422p"/>
  <arg name="camera_name" default="dock_camera"/>
  <arg name="camera_info_url" default="file://$(find grasp_hexapod_control)/config/dock_camera.yaml"/>
  
  <arg name="image_width" default="640"/>
  <arg name="image_height" default="480"/>
  <arg name="framerate" default="20"/>
  <arg name="camera_frame_id" default="dock_camera_optical_frame"/>
  <arg name="lock_frame" default="dock_lock_center"/>
  <arg name="pin_frame_prefix" default="dock_pin_from_tag_"/>
  <arg name="dock_system_config" default="$(find grasp_hexapod_control)/config/dock_system.yaml"/>
  <arg name="detections_topic" default="/dock/tag_detections"/>

  <include file="$(find grasp_hexapod_control)/launch/dock_tf_chain.launch">
    <arg name="lock_frame" value="$(arg lock_frame)"/>
    <arg name="camera_frame" value="$(arg camera_frame_id)"/>
    <arg name="pin_frame_prefix" value="$(arg pin_frame_prefix)"/>
    <arg name="dock_system_config" value="$(arg dock_system_config)"/>
  </include>

  <!-- CSI 相机节点：直接发布到 dock_camera 话题 -->
  <node name="csi_cam_pub" pkg="jetson_nano_csi_cam" type="csi_pub.py" output="screen">
    <param name="image_width" value="$(arg image_width)"/>
    <param name="image_height" value="$(arg image_height)"/>
    <param name="framerate" value="$(arg framerate)"/>
    <param name="sensor_id" value="0"/>
    <param name="image_topic" value="/dock_camera/image_raw"/>
    <param name="info_topic" value="/dock_camera/camera_info"/>
  </node>

  <!-- image_proc：使用 nodelet standalone 模式，只启动一次 -->
  <!-- <node pkg="nodelet" type="nodelet" name="image_proc_nodelet" args="standalone image_proc/rectify" output="screen">
    <remap from="image" to="/dock_camera/image_raw"/>
    <remap from="camera_info" to="/dock_camera/camera_info"/>
    <remap from="image_rect" to="/dock_camera/image_rect_color"/>
  </node> -->

  <!-- AprilTag -->
  <!-- <node pkg="apriltag_ros" type="apriltag_ros_continuous_node" name="apriltag" ns="dock" output="screen">
    <remap from="image_rect" to="/dock_camera/image_rect_color"/>
    <remap from="camera_info" to="/dock_camera/camera_info"/>
    <remap from="tag_detections" to="$(arg detections_topic)"/>
    <rosparam command="load" file="$(arg dock_system_config)"/>
  </node> -->
  <!-- AprilTag 直接订阅原始图像（跳过 image_proc） -->
  <node pkg="apriltag_ros" type="apriltag_ros_continuous_node" name="apriltag" ns="dock" output="screen" launch-prefix="bash -c 'sleep 2; $0 $@'">
    <remap from="image_rect" to="/dock_camera/image_raw"/>
    <remap from="camera_info" to="/dock_camera/camera_info"/>
    <remap from="tag_detections" to="$(arg detections_topic)"/>
    <rosparam command="load" file="$(arg dock_system_config)"/>
  </node>
</launch>