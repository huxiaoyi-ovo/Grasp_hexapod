<launch>
  <!-- 实机全 C++ 链路：joy -> run_real_cpp -> C++ Servo后端。
       与 grasp_hexapod_control/launch/run_real.launch（Python 版）完全独立：
       本文件不包含任何 Python 高层控制器切换参数；感知/导航子链
       （dock_tag_system / navigation_rtk_imu）作为独立子系统按需启动。 -->

  <!-- ============================================================
       模块 1：手柄与控制模式
       ============================================================ -->
  <arg name="joy_dev" default="/dev/input/js0"/>
  <!-- mode只允许teleop或navigation；导航模式下手柄仍可接管。 -->
  <arg name="mode" default="teleop"/>

  <!-- ============================================================
       模块 2：舵机串口与 C++ 舵机后端
       本链路固定使用 C++ 舵机后端（grasp_hexapod_servo_cpp）。
       ============================================================ -->
  <!-- 左/右两块舵机板的串口设备。 -->
  <arg name="left_port" default="/dev/ttyTHS0"/>
  <arg name="right_port" default="/dev/ttyACM0"/>
  <!-- 舵机指令下发频率与单帧指令时长（毫秒）。 -->
  <arg name="servo_rate_hz" default="30.0"/>
  <arg name="command_duration_ms" default="33"/>
  <!-- 舵机诊断信息开关。 -->
  <arg name="servo_diagnostics" default="false"/>
  <!-- 电压读取开关：轮询电压占用串口总线，默认关闭。 -->
  <arg name="voltage_read" default="false"/>

  <!-- ============================================================
       模块 3：高层控制器运行与输入门限
       ============================================================ -->
  <!-- 控制器主循环频率；碰撞自检开关（检查连杆间干涉）。 -->
  <arg name="controller_rate_hz" default="30.0"/>
  <arg name="enable_link_collision_check" default="false"/>
  <!-- 关节反馈新鲜度门限：超龄或左右板时间戳错开过大即拒绝控制。 -->
  <arg name="max_feedback_age" default="0.30"/>
  <arg name="max_feedback_skew" default="0.20"/>
  <!-- 手柄输入新鲜度门限与摇杆死区。 -->
  <arg name="max_joy_age" default="0.2"/>
  <arg name="joy_deadzone" default="0.20"/>

  <!-- ============================================================
       模块 4：手柄按键与摇杆轴映射
       button_* 为按键序号，axis_* 为轴序号，axis_*_scale 为方向。
       ============================================================ -->
  <!-- 面板按键：A/B/X/Y。X 为实机攀爬入口，A/B 用于高度微调等。 -->
  <arg name="button_a" default="0"/>
  <arg name="button_b" default="1"/>
  <arg name="button_x" default="2"/>
  <arg name="button_y" default="3"/>
  <!-- 轴功能分配：夹爪（方向键）、平移、偏航、身体升降。 -->
  <arg name="axis_gripper" default="6"/>
  <arg name="axis_right" default="0"/>
  <arg name="axis_forward" default="1"/>
  <arg name="axis_yaw" default="3"/>
  <arg name="axis_body_down" default="4"/>
  <arg name="axis_body_up" default="5"/>
  <!-- 轴方向翻转：-1.0 表示该轴物理正方向与逻辑正方向相反。 -->
  <arg name="axis_right_scale" default="-1.0"/>
  <arg name="axis_forward_scale" default="1.0"/>
  <arg name="axis_yaw_scale" default="1.0"/>
  <arg name="axis_body_scale" default="-1.0"/>

  <!-- ============================================================
       模块 5：实机攀爬入口（按 X 触发）
       ============================================================ -->
  <!-- 攀爬总开关；关闭时按 X 仅打印警告。 -->
  <arg name="enable_real_climb" default="true"/>
  <!-- 紧凑构型攀爬方向：left 或 right。 -->
  <arg name="climb_side" default="left"/>
  <!-- 攀爬进入门限：落足点目标误差超过该值（米）不允许进入。 -->
  <arg name="climb_foot_gate_m" default="0.05"/>

  <!-- ============================================================
       模块 6：攀爬安全监控（攀爬过程中的位姿/IMU 门限）
       imu_topic 同时供 RTK/IMU 导航子链与攀爬监控使用。
       ============================================================ -->
  <arg name="imu_topic" default="/grasp_hexapod/imu"/>
  <!-- IMU 数据最大允许龄期（秒），超龄则监控失效。 -->
  <arg name="real_climb_max_imu_age" default="0.2"/>
  <!-- 攀爬期间相对起点的位置/姿态误差上限，超限判定攀爬失败。 -->
  <arg name="real_climb_max_position_error_m" default="0.05"/>
  <arg name="real_climb_max_orientation_error_deg" default="10.0"/>
  <!-- 角速度上限（度/秒）与连续超限帧数（去抖）。 -->
  <arg name="real_climb_max_angular_speed_deg_s" default="30.0"/>
  <arg name="real_climb_persistence_frames" default="3"/>

  <!-- ============================================================
       模块 7：导航（navigation 模式 + RTK/IMU 子链）
       ============================================================ -->
  <!-- 默认沿用外部PoseStamped导航源；显式启用后由双RTK/IMU适配节点生成。 -->
  <arg name="start_rtk_imu_navigation" default="false"/>
  <arg name="navigation_sensor_config" default="$(find grasp_hexapod_control)/config/navigation_rtk_imu.yaml"/>
  <!-- 本机与"小蓝"（目标车）的 RTK fix 话题。 -->
  <arg name="robot_fix_topic" default="/grasp_hexapod/rtk/fix"/>
  <arg name="xiaolan_fix_topic" default="/grasp_hexapod/xiaolan/rtk/fix"/>
  <!-- 导航平移/升降限速。 -->
  <arg name="max_linear_speed" default="0.20"/>
  <arg name="max_vertical_speed" default="0.02"/>
  <!-- 导航位姿/边界输入的新鲜度门限。 -->
  <arg name="max_pose_age" default="0.5"/>
  <arg name="max_pose_skew" default="0.2"/>
  <arg name="max_boundary_age" default="1.0"/>
  <!-- 边界收缩余量与对本车/小蓝的车身净空（米）。 -->
  <arg name="navigation_boundary_margin_m" default="0.03"/>
  <arg name="navigation_xiaolan_body_clearance_m" default="0.13"/>
  <!-- 导航输入/输出话题：本车位姿、小蓝位姿、光伏边界、落地确认。 -->
  <arg name="base_pose_topic" default="/grasp_hexapod/navigation/base_pose"/>
  <arg name="xiaolan_pose_topic" default="/grasp_hexapod/navigation/xiaolan_pose"/>
  <arg name="pv_boundary_topic" default="/grasp_hexapod/navigation/pv_boundary"/>
  <arg name="landing_topic" default="/grasp_hexapod/landing_confirmed"/>

  <!-- ============================================================
       模块 8：回站（dock）控制与决策
       ============================================================ -->
  <!-- 回站总开关与锁定确认话题。 -->
  <arg name="enable_real_dock" default="true"/>
  <arg name="lock_confirmed_topic" default="/grasp_hexapod/dock/lock_confirmed"/>
  <!-- 回站系统标定/参数配置文件。 -->
  <arg name="dock_system_config" default="$(find grasp_hexapod_control)/config/dock_system.yaml"/>
  <!-- 标定校验：必须使用实机标定结果，禁止未标定数据。 -->
  <arg name="dock_require_real_calibrated" default="true"/>
  <arg name="dock_allow_uncalibrated" default="false"/>
  <!-- 锁定确认消息最大允许龄期（秒）。 -->
  <arg name="dock_lock_confirmation_max_age_s" default="0.5"/>
  <!-- 是否允许在线推理定位；是否强制要求锁定确认才动作。 -->
  <arg name="dock_allow_inference" default="false"/>
  <arg name="dock_require_lock_confirmation" default="false"/>
  <!-- 定位去抖：最少连续稳定帧数与感知数据最大龄期（秒）。 -->
  <arg name="dock_min_stable_frames" default="10"/>
  <arg name="dock_max_perception_age" default="0.35"/>
  <!-- 回站运动参数：直线速度、控制频率、感知频率、抬腿速度、
       坐落稳定等待时间。 -->
  <arg name="dock_linear_speed_m_s" default="0.05"/>
  <arg name="dock_update_rate_hz" default="30.0"/>
  <arg name="dock_perception_rate_hz" default="10.0"/>
  <arg name="dock_leg_lift_speed_m_s" default="0.05"/>
  <arg name="dock_sit_settle_duration_s" default="0.5"/>
  <!-- 锁定中心与定位销的 TF 坐标系命名。 -->
  <arg name="dock_lock_frame" default="dock_lock_center"/>
  <arg name="dock_pin_frame_prefix" default="dock_pin_from_tag_"/>

  <!-- ============================================================
       模块 9：回站相机硬件与检测话题（dock_tag_system 感知子链）
       ============================================================ -->
  <!-- 感知子链启动开关。 -->
  <arg name="start_dock_perception" default="true"/>
  <!-- 相机设备与分辨率/帧率/像素格式。 -->
  <arg name="dock_video_device" default="/dev/video0"/>
  <arg name="dock_image_width" default="1280"/>
  <arg name="dock_image_height" default="720"/>
  <!-- <arg name="dock_image_width" default="640"/>
  <arg name="dock_image_height" default="480"/> -->
  <arg name="dock_framerate" default="10"/>
  <arg name="dock_pixel_format" default="yuyv"/>
  <arg name="dock_color_format" default="yuv422p"/>
  <!-- 相机命名、标定文件与光学坐标系。 -->
  <arg name="dock_camera_name" default="dock_camera"/>
  <arg name="dock_camera_info_url" default="file://$(find grasp_hexapod_control)/config/dock_camera.yaml"/>
  <arg name="dock_camera_frame_id" default="dock_camera_optical_frame"/>
  <!-- 图像/标定/检测结果话题：图像与标定供控制节点复核，
       检测结果供回站定位。 -->
  <arg name="dock_detections_topic" default="/dock/tag_detections"/>
  <arg name="dock_image_topic" default="/dock_camera/image_raw"/>
  <arg name="dock_camera_info_topic" default="/dock_camera/camera_info"/>

  <!-- ============================================================
       子链启动（顺序：导航 -> 控制 -> 感知 -> 舵机）
       ============================================================ -->

  <!-- RTK/IMU 导航适配子链（仅 start_rtk_imu_navigation 时启动）。 -->
  <include
    file="$(find grasp_hexapod_control)/launch/navigation_rtk_imu.launch"
    if="$(arg start_rtk_imu_navigation)">
    <arg name="config" value="$(arg navigation_sensor_config)"/>
    <arg name="robot_fix_topic" value="$(arg robot_fix_topic)"/>
    <arg name="xiaolan_fix_topic" value="$(arg xiaolan_fix_topic)"/>
    <arg name="imu_topic" value="$(arg imu_topic)"/>
    <arg name="base_pose_topic" value="$(arg base_pose_topic)"/>
    <arg name="xiaolan_pose_topic" value="$(arg xiaolan_pose_topic)"/>
    <arg name="pv_boundary_topic" value="$(arg pv_boundary_topic)"/>
  </include>

  <!-- C++ 高层控制栈：joy_node + run_real_cpp。 -->
  <include file="$(find grasp_hexapod_control)/launch/control_stack_cpp.launch">
    <arg name="control_source" value="$(arg mode)"/>
    <arg name="joy_dev" value="$(arg joy_dev)"/>
    <arg name="controller_rate_hz" value="$(arg controller_rate_hz)"/>
    <arg
      name="enable_link_collision_check"
      value="$(arg enable_link_collision_check)"/>
    <arg name="max_feedback_age" value="$(arg max_feedback_age)"/>
    <arg name="max_feedback_skew" value="$(arg max_feedback_skew)"/>
    <arg name="climb_foot_gate_m" value="$(arg climb_foot_gate_m)"/>
    <arg name="max_joy_age" value="$(arg max_joy_age)"/>
    <arg name="joy_deadzone" value="$(arg joy_deadzone)"/>
    <arg name="enable_real_climb" value="$(arg enable_real_climb)"/>
    <arg name="climb_side" value="$(arg climb_side)"/>
    <arg name="enable_real_dock" value="$(arg enable_real_dock)"/>
    <arg name="button_a" value="$(arg button_a)"/>
    <arg name="button_b" value="$(arg button_b)"/>
    <arg name="button_x" value="$(arg button_x)"/>
    <arg name="button_y" value="$(arg button_y)"/>
    <arg name="axis_gripper" value="$(arg axis_gripper)"/>
    <arg name="axis_right" value="$(arg axis_right)"/>
    <arg name="axis_forward" value="$(arg axis_forward)"/>
    <arg name="axis_yaw" value="$(arg axis_yaw)"/>
    <arg name="axis_body_down" value="$(arg axis_body_down)"/>
    <arg name="axis_body_up" value="$(arg axis_body_up)"/>
    <arg name="axis_right_scale" value="$(arg axis_right_scale)"/>
    <arg name="axis_forward_scale" value="$(arg axis_forward_scale)"/>
    <arg name="axis_yaw_scale" value="$(arg axis_yaw_scale)"/>
    <arg name="axis_body_scale" value="$(arg axis_body_scale)"/>
    <arg name="max_linear_speed" value="$(arg max_linear_speed)"/>
    <arg name="max_vertical_speed" value="$(arg max_vertical_speed)"/>
    <arg name="max_pose_age" value="$(arg max_pose_age)"/>
    <arg name="max_pose_skew" value="$(arg max_pose_skew)"/>
    <arg name="max_boundary_age" value="$(arg max_boundary_age)"/>
    <arg name="navigation_boundary_margin_m" value="$(arg navigation_boundary_margin_m)"/>
    <arg name="navigation_xiaolan_body_clearance_m" value="$(arg navigation_xiaolan_body_clearance_m)"/>
    <arg name="base_pose_topic" value="$(arg base_pose_topic)"/>
    <arg name="xiaolan_pose_topic" value="$(arg xiaolan_pose_topic)"/>
    <arg name="pv_boundary_topic" value="$(arg pv_boundary_topic)"/>
    <arg name="landing_topic" value="$(arg landing_topic)"/>
    <arg name="imu_topic" value="$(arg imu_topic)"/>
    <arg name="real_climb_max_imu_age" value="$(arg real_climb_max_imu_age)"/>
    <arg name="real_climb_max_position_error_m" value="$(arg real_climb_max_position_error_m)"/>
    <arg name="real_climb_max_orientation_error_deg" value="$(arg real_climb_max_orientation_error_deg)"/>
    <arg name="real_climb_max_angular_speed_deg_s" value="$(arg real_climb_max_angular_speed_deg_s)"/>
    <arg name="real_climb_persistence_frames" value="$(arg real_climb_persistence_frames)"/>
    <arg name="lock_confirmed_topic" value="$(arg lock_confirmed_topic)"/>
    <arg name="dock_image_topic" value="$(arg dock_image_topic)"/>
    <arg name="dock_camera_info_topic" value="$(arg dock_camera_info_topic)"/>
    <arg name="dock_system_config" value="$(arg dock_system_config)"/>
    <arg name="dock_require_real_calibrated" value="$(arg dock_require_real_calibrated)"/>
    <arg name="dock_allow_uncalibrated" value="$(arg dock_allow_uncalibrated)"/>
    <arg name="dock_lock_confirmation_max_age_s" value="$(arg dock_lock_confirmation_max_age_s)"/>
    <arg name="dock_allow_inference" value="$(arg dock_allow_inference)"/>
    <arg name="dock_require_lock_confirmation" value="$(arg dock_require_lock_confirmation)"/>
    <arg name="dock_min_stable_frames" value="$(arg dock_min_stable_frames)"/>
    <arg name="dock_max_perception_age" value="$(arg dock_max_perception_age)"/>
    <arg name="dock_linear_speed_m_s" value="$(arg dock_linear_speed_m_s)"/>
    <arg name="dock_update_rate_hz" value="$(arg dock_update_rate_hz)"/>
    <arg name="dock_perception_rate_hz" value="$(arg dock_perception_rate_hz)"/>
    <arg name="dock_leg_lift_speed_m_s" value="$(arg dock_leg_lift_speed_m_s)"/>
    <arg name="dock_sit_settle_duration_s" value="$(arg dock_sit_settle_duration_s)"/>
    <arg name="dock_lock_frame" value="$(arg dock_lock_frame)"/>
    <arg name="dock_pin_frame_prefix" value="$(arg dock_pin_frame_prefix)"/>
  </include>

  <!-- 回站感知子链：相机驱动 + tag 检测（仅 start_dock_perception 时启动）。 -->
  <include
    file="$(find grasp_hexapod_control)/launch/dock_tag_system.launch"
    if="$(arg start_dock_perception)">
    <arg name="video_device" value="$(arg dock_video_device)"/>
    <arg name="image_width" value="$(arg dock_image_width)"/>
    <arg name="image_height" value="$(arg dock_image_height)"/>
    <arg name="framerate" value="$(arg dock_framerate)"/>
    <arg name="pixel_format" value="$(arg dock_pixel_format)"/>
    <arg name="color_format" value="$(arg dock_color_format)"/>
    <arg name="camera_name" value="$(arg dock_camera_name)"/>
    <arg name="camera_info_url" value="$(arg dock_camera_info_url)"/>
    <arg name="camera_frame_id" value="$(arg dock_camera_frame_id)"/>
    <arg name="lock_frame" value="$(arg dock_lock_frame)"/>
    <arg name="pin_frame_prefix" value="$(arg dock_pin_frame_prefix)"/>
    <arg name="dock_system_config" value="$(arg dock_system_config)"/>
    <arg name="detections_topic" value="$(arg dock_detections_topic)"/>
  </include>

  <!-- C++ 舵机双板后端（左右串口 + 夹爪 id=99）。 -->
  <include
    file="$(find grasp_hexapod_servo)/launch/servo_two_boards_cpp.launch">
    <arg name="left_port" value="$(arg left_port)"/>
    <arg name="right_port" value="$(arg right_port)"/>
    <arg name="servo_rate_hz" value="$(arg servo_rate_hz)"/>
    <arg name="command_duration_ms" value="$(arg command_duration_ms)"/>
    <arg name="servo_diagnostics" value="$(arg servo_diagnostics)"/>
    <arg name="voltage_read" value="$(arg voltage_read)"/>
    <arg name="gripper_id" value="99"/>
    <arg name="gripper_command_duration_ms" value="400"/>
  </include>
</launch>
