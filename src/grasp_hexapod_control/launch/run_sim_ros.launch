<launch>
  <!-- ROS链路：joy -> GraspController -> Isaac Gym -> 关节反馈。 -->
  <arg name="joy_dev" default="/dev/input/js0"/>
  <!-- mode只允许teleop或navigation；导航模式下手柄仍可接管。 -->
  <arg name="mode" default="teleop"/>
  <arg name="controller_rate_hz" default="30.0"/>
  <arg name="actuator_rate_hz" default="30.0"/>
  <arg name="physics_rate_hz" default="240.0"/>
  <!-- 普通仿真默认使用LX-15D 7.4V官方空载速度上限候选。 -->
  <arg name="joint_speed" default="1.2"/>
  <arg name="climb_joint_speed" default="1.2"/>
  <arg name="climb_side" default="left"/>
  <arg name="climb_scene" default="false"/>
  <arg name="enable_climb" default="$(arg climb_scene)"/>
  <arg name="headless" default="false"/>
  <arg name="max_joy_age" default="0.2"/>
  <arg name="joy_deadzone" default="0.20"/>
  <arg
    name="python_executable"
    default="/usr/bin/python3"/>
  <arg
    name="isaacgym_python_path"
    default="/home/artrc/isaacgym/python"/>
  <arg name="button_a" default="0"/>
  <arg name="button_b" default="1"/>
  <arg name="button_x" default="2"/>
  <arg name="button_y" default="3"/>
  <arg name="axis_right" default="0"/>
  <arg name="axis_forward" default="1"/>
  <arg name="axis_yaw" default="3"/>
  <arg name="axis_body_down" default="4"/>
  <arg name="axis_body_up" default="5"/>
  <arg name="axis_right_scale" default="-1.0"/>
  <arg name="axis_forward_scale" default="1.0"/>
  <arg name="axis_yaw_scale" default="1.0"/>
  <arg name="axis_body_scale" default="-1.0"/>

  <arg name="max_linear_speed" default="0.20"/>
  <arg name="max_vertical_speed" default="0.02"/>

  <!-- ROS只负责输入；控制器在Isaac的30 Hz控制帧内同步运行。 -->
  <node
    pkg="joy"
    type="joy_node"
    name="joy_node"
    output="screen"
    required="true">
    <param name="dev" value="$(arg joy_dev)"/>
    <param name="deadzone" value="$(arg joy_deadzone)"/>
    <param name="autorepeat_rate" value="60.0"/>
    <param name="coalesce_interval" value="0.001"/>
  </node>

  <!-- 这些参数属于下面两个条件分支中同名的grasp_hexapod_sim节点。 -->
  <param name="grasp_hexapod_sim/control_source" value="$(arg mode)"/>
  <param
    name="grasp_hexapod_sim/max_joy_age"
    value="$(arg max_joy_age)"/>
  <param name="grasp_hexapod_sim/button_a" value="$(arg button_a)"/>
  <param name="grasp_hexapod_sim/button_b" value="$(arg button_b)"/>
  <param name="grasp_hexapod_sim/button_x" value="$(arg button_x)"/>
  <param name="grasp_hexapod_sim/button_y" value="$(arg button_y)"/>
  <param name="grasp_hexapod_sim/enable_real_climb" value="$(arg enable_climb)"/>
  <param name="grasp_hexapod_sim/axis_right" value="$(arg axis_right)"/>
  <param name="grasp_hexapod_sim/axis_forward" value="$(arg axis_forward)"/>
  <param name="grasp_hexapod_sim/axis_yaw" value="$(arg axis_yaw)"/>
  <param
    name="grasp_hexapod_sim/axis_body_down"
    value="$(arg axis_body_down)"/>
  <param
    name="grasp_hexapod_sim/axis_body_up"
    value="$(arg axis_body_up)"/>
  <param
    name="grasp_hexapod_sim/axis_right_scale"
    value="$(arg axis_right_scale)"/>
  <param
    name="grasp_hexapod_sim/axis_forward_scale"
    value="$(arg axis_forward_scale)"/>
  <param
    name="grasp_hexapod_sim/axis_yaw_scale"
    value="$(arg axis_yaw_scale)"/>
  <param
    name="grasp_hexapod_sim/axis_body_scale"
    value="$(arg axis_body_scale)"/>
  <param
    name="grasp_hexapod_sim/max_linear_speed"
    value="$(arg max_linear_speed)"/>
  <param
    name="grasp_hexapod_sim/max_vertical_speed"
    value="$(arg max_vertical_speed)"/>

  <group unless="$(arg headless)">
    <node
      pkg="grasp_hexapod_control"
      type="run_sim.py"
      name="grasp_hexapod_sim"
      output="screen"
      required="true"
      launch-prefix="$(arg python_executable)"
      unless="$(arg climb_scene)"
      args="--ros --control-rate $(arg controller_rate_hz) --actuator-rate $(arg actuator_rate_hz) --physics-rate $(arg physics_rate_hz) --joint-speed $(arg joint_speed) --climb-joint-speed $(arg climb_joint_speed) --climb-side $(arg climb_side)">
      <env
        name="PYTHONPATH"
        value="$(arg isaacgym_python_path):$(env PYTHONPATH)"/>
    </node>
    <node
      pkg="grasp_hexapod_control"
      type="run_sim.py"
      name="grasp_hexapod_sim"
      output="screen"
      required="true"
      launch-prefix="$(arg python_executable)"
      if="$(arg climb_scene)"
      args="--ros --climb-scene --control-rate $(arg controller_rate_hz) --actuator-rate $(arg actuator_rate_hz) --physics-rate $(arg physics_rate_hz) --joint-speed $(arg joint_speed) --climb-joint-speed $(arg climb_joint_speed) --climb-side $(arg climb_side)">
      <env
        name="PYTHONPATH"
        value="$(arg isaacgym_python_path):$(env PYTHONPATH)"/>
    </node>
  </group>

  <group if="$(arg headless)">
    <node
      pkg="grasp_hexapod_control"
      type="run_sim.py"
      name="grasp_hexapod_sim"
      output="screen"
      required="true"
      launch-prefix="$(arg python_executable)"
      unless="$(arg climb_scene)"
      args="--ros --headless --control-rate $(arg controller_rate_hz) --actuator-rate $(arg actuator_rate_hz) --physics-rate $(arg physics_rate_hz) --joint-speed $(arg joint_speed) --climb-joint-speed $(arg climb_joint_speed) --climb-side $(arg climb_side)">
      <env
        name="PYTHONPATH"
        value="$(arg isaacgym_python_path):$(env PYTHONPATH)"/>
    </node>
    <node
      pkg="grasp_hexapod_control"
      type="run_sim.py"
      name="grasp_hexapod_sim"
      output="screen"
      required="true"
      launch-prefix="$(arg python_executable)"
      if="$(arg climb_scene)"
      args="--ros --headless --climb-scene --control-rate $(arg controller_rate_hz) --actuator-rate $(arg actuator_rate_hz) --physics-rate $(arg physics_rate_hz) --joint-speed $(arg joint_speed) --climb-joint-speed $(arg climb_joint_speed) --climb-side $(arg climb_side)">
      <env
        name="PYTHONPATH"
        value="$(arg isaacgym_python_path):$(env PYTHONPATH)"/>
    </node>
  </group>
</launch>
