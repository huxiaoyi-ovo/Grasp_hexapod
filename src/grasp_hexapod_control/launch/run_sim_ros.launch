<launch>
  <!-- ROS链路：joy -> GraspController -> Isaac Gym -> 关节反馈。 -->
  <arg name="joy_dev" default="/dev/input/js0"/>
  <!-- mode只允许teleop或navigation；导航模式下手柄仍可接管。 -->
  <arg name="mode" default="teleop"/>
  <arg name="control_rate_hz" default="30.0"/>
  <arg name="physics_rate_hz" default="240.0"/>
  <arg name="headless" default="false"/>
  <arg
    name="python_executable"
    default="/usr/bin/python3"/>
  <arg
    name="isaacgym_python_path"
    default="/home/artrc/isaacgym/python"/>

  <arg name="button_a" default="0"/>
  <arg name="button_b" default="1"/>
  <arg name="button_x" default="2"/>
  <arg name="button_y" default="3"/>
  <arg name="axis_right" default="0"/>
  <arg name="axis_forward" default="1"/>
  <arg name="axis_yaw" default="3"/>
  <arg name="axis_body_down" default="4"/>
  <arg name="axis_body_up" default="5"/>

  <arg name="max_linear_speed" default="0.02"/>
  <arg name="max_vertical_speed" default="0.005"/>
  <arg name="xiaolan_from_left_base" default="[]"/>
  <arg name="xiaolan_from_right_base" default="[]"/>

  <include file="$(find grasp_hexapod_control)/launch/control_stack.launch">
    <arg name="control_source" value="$(arg mode)"/>
    <arg name="joy_dev" value="$(arg joy_dev)"/>
    <arg name="control_rate_hz" value="$(arg control_rate_hz)"/>
    <arg name="button_a" value="$(arg button_a)"/>
    <arg name="button_b" value="$(arg button_b)"/>
    <arg name="button_x" value="$(arg button_x)"/>
    <arg name="button_y" value="$(arg button_y)"/>
    <arg name="axis_right" value="$(arg axis_right)"/>
    <arg name="axis_forward" value="$(arg axis_forward)"/>
    <arg name="axis_yaw" value="$(arg axis_yaw)"/>
    <arg name="axis_body_down" value="$(arg axis_body_down)"/>
    <arg name="axis_body_up" value="$(arg axis_body_up)"/>
    <arg name="max_linear_speed" value="$(arg max_linear_speed)"/>
    <arg name="max_vertical_speed" value="$(arg max_vertical_speed)"/>
    <arg
      name="xiaolan_from_left_base"
      value="$(arg xiaolan_from_left_base)"/>
    <arg
      name="xiaolan_from_right_base"
      value="$(arg xiaolan_from_right_base)"/>
  </include>

  <group unless="$(arg headless)">
    <node
      pkg="grasp_hexapod_control"
      type="run_sim.py"
      name="grasp_hexapod_sim"
      output="screen"
      required="true"
      launch-prefix="$(arg python_executable)"
      args="--ros --control-rate $(arg control_rate_hz) --physics-rate $(arg physics_rate_hz)">
      <env
        name="PYTHONPATH"
        value="$(arg isaacgym_python_path):$(env PYTHONPATH)"/>
    </node>
  </group>

  <group if="$(arg headless)">
    <node
      pkg="grasp_hexapod_control"
      type="run_sim.py"
      name="grasp_hexapod_sim"
      output="screen"
      required="true"
      launch-prefix="$(arg python_executable)"
      args="--ros --headless --control-rate $(arg control_rate_hz) --physics-rate $(arg physics_rate_hz)">
      <env
        name="PYTHONPATH"
        value="$(arg isaacgym_python_path):$(env PYTHONPATH)"/>
    </node>
  </group>
</launch>
