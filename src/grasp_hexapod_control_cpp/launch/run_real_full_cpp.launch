<launch>
  <!-- 实机全 C++ 控制器入口：高层控制（run_real_cpp）+ C++ 舵机后端。
       等价于 run_real_cpp.launch + control_backend:=cpp。 -->
  <arg name="control_backend" value="cpp"/>
  <arg name="servo_backend" value="cpp"/>

  <include
    file="$(find grasp_hexapod_control)/launch/run_real.launch"
    pass_all_args="true"/>
</launch>
