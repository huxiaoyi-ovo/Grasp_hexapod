<?xml version="1.0"?>
<package format="2">
  <name>grasp_hexapod_control_cpp</name>
  <version>0.0.0</version>
  <description>
    Grasp Hexapod 的高层控制器（C++/roscpp 版），逐函数移植自
    grasp_hexapod_control/scripts/run_real.py 及其计算依赖
    （control.py / kinematics.py / climb_mode.py / dock_mode.py / approach_mode.py / utils）。
    ROS 话题、服务、参数与 Python 版完全一致，通过 control_backend 参数切换，用于
    消除解释器/GIL/OpenBLAS 开销，稳定 30 Hz 控制循环并释放机载算力。
  </description>
  <maintainer email="artrc@todo.todo">artrc</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>grasp_hexapod_msgs</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>tf2</build_depend>
  <build_depend>roslib</build_depend>

  <build_export_depend>grasp_hexapod_msgs</build_export_depend>
  <build_export_depend>roscpp</build_export_depend>
  <build_depend>message_runtime</build_depend>
  <build_export_depend>sensor_msgs</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>tf2_ros</build_export_depend>
  <build_export_depend>tf2</build_export_depend>
  <build_export_depend>roslib</build_export_depend>

  <exec_depend>grasp_hexapod_msgs</exec_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2</exec_depend>
  <exec_depend>roslib</exec_depend>
  <!-- 共享 Python 控制包的 config/climb_compact.json 等配置文件。 -->
  <exec_depend>grasp_hexapod_control</exec_depend>
  <exec_depend>grasp_hexapod_description</exec_depend>
</package>
