<?xml version="1.0" encoding="utf-8"?>
<robot name="hexapod_robot">
  <!-- Inertia tensors are volume integrals of the closed visual STL meshes,
       scaled to the existing link masses. Link masses and COM origins are unchanged. -->
  <material name="white"><color rgba="1 1 1 1"/></material>
  <material name="foot_black"><color rgba="0.02 0.02 0.02 1"/></material>
  <link name="base_link">
    <inertial>
      <origin xyz="0.00048381 0.0032191 0.050559" rpy="0 0 0"/>
      <mass value="3"/>
      <inertia ixx="9.35453162E-03" ixy="2.69285006E-05" ixz="-4.04233289E-05" iyy="8.06154892E-03" iyz="2.59534403E-05" izz="8.04436278E-03"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/body_link.STL"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <!-- Body collision: regular-hexagon outer circumcircle approximation.
           Hexagon perimeter = 0.733 m, side length = circumradius = 0.1221667 m.
           Height = 0.121 m; origin z=0.0605 assumes base_link z=0 is the body bottom plane. -->
      <origin xyz="0 0 0.0605" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.097" length="0.121"/>
      </geometry>
    </collision>
  </link>
