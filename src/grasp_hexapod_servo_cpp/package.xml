<?xml version="1.0"?>
<package format="2">
  <name>grasp_hexapod_servo_cpp</name>
  <version>0.0.0</version>
  <description>
    Grasp Hexapod 的 LX-15D 舵机驱动（C++/roscpp 版）。
    接口与 grasp_hexapod_servo（Python 版）完全一致，用于降低资源占用、提高运行速度。
  </description>
  <maintainer email="artrc@todo.todo">artrc</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>grasp_hexapod_msgs</build_depend>
  <build_depend>message_generation</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>serial</build_depend>
  <build_depend>std_msgs</build_depend>

  <build_export_depend>grasp_hexapod_msgs</build_export_depend>
  <build_export_depend>message_runtime</build_export_depend>
  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>sensor_msgs</build_export_depend>
  <build_export_depend>serial</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>

  <exec_depend>grasp_hexapod_msgs</exec_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>serial</exec_depend>
  <exec_depend>std_msgs</exec_depend>
</package>
