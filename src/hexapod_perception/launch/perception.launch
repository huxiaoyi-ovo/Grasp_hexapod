<launch>
  <arg name="model_path" default="$(find hexapod_perception)/models/xiaolan_unified_seg.pt"/>
  <arg name="output_frame" default="base_link"/>
  <arg name="device" default="cpu"/>

  <node pkg="hexapod_perception" type="perception_node"
        name="hexapod_perception" output="screen">
    <param name="model_path" value="$(arg model_path)"/>
    <param name="output_frame" value="$(arg output_frame)"/>
    <param name="device" value="$(arg device)"/>
    <param name="color_topic" value="/camera/color/image_raw"/>
    <param name="depth_topic" value="/camera/depth/image_raw"/>
    <param name="camera_info_topic" value="/camera/color/camera_info"/>
    <param name="board_class" value="board"/>
    <param name="xiaolan_class" value="platform_robot"/>
    <param name="confidence" value="0.15"/>
    <param name="front_feature_confidence" value="0.15"/>
    <param name="green_feature_confidence" value="0.15"/>
    <param name="image_size" value="640"/>
    <param name="erosion_pixels" value="2"/>
    <param name="depth_stride" value="3"/>
    <param name="maximum_plane_rmse" value="0.035"/>
    <param name="minimum_plane_normal_z" value="0.10"/>
    <param name="front_hold_seconds" value="0.5"/>
  </node>
</launch>
